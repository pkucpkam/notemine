# Firebase Configuration
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Your Firebase Auth UID (get from Firebase Console > Authentication after first login)
VITE_ALLOWED_UID=your-firebase-uid-here

# GitHub repos to sync — format: owner/repo:branch,owner/repo2:branch2
# Example: VITE_GITHUB_REPOS=pkucpkam/notes:main,pkucpkam/blog:main
VITE_GITHUB_REPOS=pkucpkam/pkucpkam-learning:main
